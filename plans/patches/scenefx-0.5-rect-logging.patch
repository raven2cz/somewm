diff --git a/render/fx_renderer/fx_pass.c b/render/fx_renderer/fx_pass.c
index 39b6226..5b34174 100644
--- a/render/fx_renderer/fx_pass.c
+++ b/render/fx_renderer/fx_pass.c
@@ -673,6 +673,61 @@ void fx_render_pass_add_rounded_rect(struct fx_gles_render_pass *pass,
 			clipped_region_corners->bottom_right);
 	push_fx_debug(renderer);
 
+	/* somewm diagnostic: print the boxes this rounded rect is actually drawn
+	 * with. The scene graph holds correct values but the result on screen is
+	 * one pixel off in x, so the question is what the renderer receives.
+	 * Opt-in, throttled, and only for frame-sized rects. */
+	{
+		static int somewm_log = -1;
+		static struct wlr_box last_box, last_clip;
+		static float last_alpha = -1;
+		if (somewm_log < 0) {
+			const char *e = getenv("SOMEWM_LOG_RECT");
+			somewm_log = e && e[0] && e[0] != '0';
+		}
+		/* Log on change, not periodically: an idle session draws few rects and
+		 * a moving window draws many, and only the values matter. */
+		static int somewm_n = 0;
+		if (somewm_log && box.width > 400
+				&& pixman_region32_not_empty(&clip_region)
+				&& (somewm_n++ % 30) == 0) {
+			(void)last_box; (void)last_clip; (void)last_alpha;
+			last_box = box;
+			last_clip = *clipped_region_box;
+			last_alpha = color->a;
+			int nr = 0;
+			const pixman_box32_t *rr = pixman_region32_rectangles(&clip_region, &nr);
+			char rects[512];
+			int off = 0;
+			for (int k = 0; k < nr && k < 8 && off < (int)sizeof(rects) - 1; k++) {
+				off += snprintf(rects + off, sizeof(rects) - off,
+						" [%d,%d %dx%d]", rr[k].x1 - box.x, rr[k].y1 - box.y,
+						rr[k].x2 - rr[k].x1, rr[k].y2 - rr[k].y1);
+			}
+			rects[off] = 0;
+			int in = 0;
+			const pixman_box32_t *ie = options->clip
+					? &options->clip->extents : NULL;
+			if (options->clip)
+				pixman_region32_rectangles(options->clip, &in);
+			wlr_log(WLR_ERROR, "[RECT] box=%dx%d+%d+%d clip=%dx%d+%d+%d "
+					"dx=%d dy=%d dw=%d dh=%d r=%.1f cr=%.1f a=%.2f | "
+					"render_region=%dx%d+%d+%d in %d rect(s) | "
+					"rasterised %d rect(s), box-relative:%s",
+					box.width, box.height, box.x, box.y,
+					clipped_region_box->width, clipped_region_box->height,
+					clipped_region_box->x, clipped_region_box->y,
+					clipped_region_box->x - box.x, clipped_region_box->y - box.y,
+					box.width - clipped_region_box->width,
+					box.height - clipped_region_box->height,
+					fx_options->corners.top_left,
+					clipped_region_corners->top_left, color->a,
+					ie ? ie->x2 - ie->x1 : 0, ie ? ie->y2 - ie->y1 : 0,
+					ie ? ie->x1 - box.x : 0, ie ? ie->y1 - box.y : 0, in,
+					nr, rects);
+		}
+	}
+
 	setup_blending(WLR_RENDER_BLEND_MODE_PREMULTIPLIED);
 
 	struct quad_round_shader shader = renderer->shaders.quad_round;
